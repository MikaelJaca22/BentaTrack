{
  "expo": {
    "name": "BentaTrack",
    "slug": "bentatrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bentatrack",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bentatrack.app"
    },
    "android": {
      "package": "com.bentatrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "expo-sharing"
    ]
  }
}
